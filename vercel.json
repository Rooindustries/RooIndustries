{
  "framework": "nextjs",
  "regions": ["dub1"],
  "functions": {
    "app/api/downloads/file/route.js": {
      "regions": ["iad1"]
    },
    "app/api/admin/content/**/*": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/admin/referral-creators/route.js": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/content/**/*": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/tools/*/download/route.js": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/admin/commerce-readiness/route.js": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/bookingAvailability/route.js": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/holdSlot/route.js": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/releaseHold/route.js": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/payment/**/*": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/razorpay/**/*": {
      "regions": [
        "dub1"
      ]
    },
    "app/api/ref/**/*": {
      "regions": [
        "dub1"
      ]
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rooindustries.com"
        }
      ],
      "destination": "https://www.rooindustries.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</fonts/manrope-latin-variable.woff2>; rel=preload; as=font; type=font/woff2; crossorigin, </favicon-96x96.png>; rel=preload; as=image"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/payment/reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/ref/cronSyncAll",
      "schedule": "*/10 * * * *"
    }
  ]
}
