    "smoke:production": "node scripts/production-smoke.mjs",
    "deploy:gate": "node scripts/production-deploy-gate.mjs",
    "test": "jest",
    "test:deploy:rollback": "node --test tests/deploy-rollback.test.mjs",
    "test:monitoring": "node scripts/monitoring-e2e.mjs",
    "test:monitoring:startup": "node scripts/monitoring-next-startup-e2e.mjs",
    "test:smoke:production": "node --test tests/production-smoke.test.mjs",
    "test:contact:csp": "playwright test tests/contact-form-csp.spec.js --project=chromium",
    "test:booking-flow": "playwright test tests/booking-flow.spec.js --project=chromium",
    "test:claims": "playwright test tests/backed-claims.spec.js --project=chromium",
    "test:booking-initial-slot": "playwright test tests/booking-initial-slot.spec.js --project=chromium",
    "test:booking-hold": "node --test tests/booking-hold.test.mjs",
    "test:booking-hold:e2e": "playwright test tests/booking-hold.spec.js --project=chromium",
    "test:booking-contact": "node scripts/test-booking-contact.mjs",
    "test:upgrade-credit": "node scripts/test-booking-contact.mjs --upgrade-credit",
    "test:upgrade-credit:ownership": "node scripts/test-booking-contact.mjs --upgrade-credit-ownership",
    "test:emails": "playwright test tests/transactional-emails.spec.js --project=chromium",
    "test:referral-email:origins": "node scripts/test-referral-email-link-origin.mjs",
    "test:emails:postgres17": "node --test tests/booking-emails.mjs",
    "test:payment-recovery:postgres17": "cross-env ROO_PAYMENT_PERSISTENCE_ARTIFACT=test-results/payment-persistence-recovery.json node scripts/test-payment-persistence-sweep.mjs --recovery --full-chain",
    "test:agent-readiness": "node --test tests/agent-readiness.test.mjs",
    "test:repo-skills": "bash tests/repo-skills-e2e.sh",
    "diagnose:repo-skills": "bash scripts/diagnose-repo-skill-harnesses.sh",
