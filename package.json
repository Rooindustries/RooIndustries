    "test:perf:cls:states": "node scripts/test-content-layout-shift.mjs --states",
    "check:payment:runtime": "node scripts/diagnose-payment-runtime.js",
    "check:payment:webhooks": "node scripts/check-payment-webhooks.js",
    "check:payment:stack": "node scripts/check-payment-stack.mjs",
    "check:payment:integrity": "node scripts/check-payment-booking-integrity.mjs",
    "migrate:payment-booking": "node scripts/migrate-payment-booking-repair.mjs",
    "upload:download:supabase": "node scripts/upload-download-supabase.mjs utilities",
    "check:supabase:migrations": "node scripts/check-supabase-migrations.mjs",
    "test:supabase:migration:fixtures": "psql \"$SUPABASE_TEST_DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/commerce_integrity.sql -f supabase/tests/tourney_auth_integrity.sql -f supabase/tests/social_auth_integrity.sql -f supabase/tests/operational_projection_integrity.sql -f supabase/tests/shadow_lookup_integrity.sql",
    "test:referral:postgres17": "node scripts/test-referral-creator-terms-postgres.mjs",
    "test:referral-social:postgres17": "node scripts/test-referral-social-reclaim-postgres.mjs",
    "test:backend-integrity:postgres17": "node scripts/test-backend-integrity-postgres.mjs",
    "test:referral-authority:postgres17": "node scripts/test-referral-fallback-authority-postgres.mjs",
    "test:referral-email:postgres17": "node scripts/test-referral-email-dispatch-postgres.mjs",
    "test:referral-integrity:postgres17": "node scripts/test-referral-integrity-hardening-postgres.mjs",
    "test:account-domain:postgres17": "node scripts/test-account-domain-identity-postgres.mjs",
    "test:commerce-readiness:postgres17": "node scripts/test-commerce-readiness-postgres.mjs",
    "repair:supabase:commerce:dry-run": "node scripts/repair-supabase-commerce-integrity.mjs",
    "repair:supabase:commerce:apply": "node scripts/repair-supabase-commerce-integrity.mjs --apply",
    "repair:referral-accounting:dry-run": "node scripts/repair-referral-accounting.mjs",
    "repair:referral-accounting:apply": "node scripts/repair-referral-accounting.mjs --apply",
    "audit:referral-accounting": "node scripts/repair-referral-accounting.mjs --audit-all",
    "export:supabase:commerce:encrypted": "node scripts/export-supabase-commerce-encrypted.mjs",
    "check:seo": "node scripts/check-seo.js",
    "check:cdn": "node scripts/check-home-cdn-cache.mjs",
    "test:seo:structured-data": "playwright test tests/structured-data.spec.js --project=chromium",
    "test:benchmarks:revalidation": "cross-env TOOLING_BENCHMARKS_REVALIDATION=1 playwright test tests/benchmarks-revalidation.spec.js --project=chromium",
    "test:static:revalidation": "cross-env TOOLING_STATIC_REVALIDATION=1 TOOLING_CLS_CONTENT=1 playwright test tests/static-pages-revalidation.spec.js --project=chromium",
    "check:budgets": "node scripts/check-budgets.js",
    "test:seo:nonjs": "playwright test tests/nonjs-seo.spec.js",
    "test:smoke:routes": "playwright test tests/routes-smoke.spec.js",
    "test:sweep": "playwright test tests/public-route-sweep.spec.js --project=chromium",
    "test:hero-heading-fit": "playwright test tests/hero-heading-fit.spec.js --project=chromium",
    "test:nav:sections": "cross-env BASE_URL=${BASE_URL:-http://${ROO_TEST_HOST:-127.0.0.1}:${PW_PORT:-3001}} playwright test tests/section-nav.spec.js",
    "test:nav:chaos": "cross-env BASE_URL=${BASE_URL:-http://${ROO_TEST_HOST:-127.0.0.1}:${PW_PORT:-3001}} playwright test tests/nav-chaos.spec.js",
    "test:footer": "playwright test tests/footer.spec.js",
    "audit:phase1:context": "cross-env BASE_URL=${BASE_URL:-http://${ROO_TEST_HOST:-127.0.0.1}:${PW_PORT:-3001}} node scripts/phase1-run-context.js",
    "audit:phase1:browser:pre": "node scripts/phase1-browser-hygiene.js",
    "audit:phase1:browser:cleanup": "cross-env APPLY_CLEANUP=1 node scripts/phase1-browser-hygiene.js",
    "audit:phase1:env": "cross-env BASE_URL=${BASE_URL:-http://${ROO_TEST_HOST:-127.0.0.1}:${PW_PORT:-3001}} node scripts/phase1-env-determinism.js",
    "audit:phase1:static": "node scripts/phase1-static-safety.js",
    "audit:phase1:route": "cross-env BASE_URL=${BASE_URL:-http://${ROO_TEST_HOST:-127.0.0.1}:${PW_PORT:-3001}} node scripts/phase1-route-contract.js",
    "audit:phase1:api": "node scripts/run-api-contract-audit.mjs",
    "audit:phase1:runtime": "cross-env BASE_URL=${BASE_URL:-http://${ROO_TEST_HOST:-127.0.0.1}:${PW_PORT:-3001}} node scripts/phase1-runtime-audits.js",
    "audit:phase1:signoff": "cross-env BASE_URL=${BASE_URL:-http://${ROO_TEST_HOST:-127.0.0.1}:${PW_PORT:-3001}} node scripts/phase1-signoff.js",
    "audit:mission-critical": "npm run audit:phase1:context && npm run audit:phase1:browser:pre && npm run audit:phase1:env && npm run audit:phase1:static && npm run test:nav:sections -- --reporter=line && npm run test:nav:chaos -- --reporter=line && npm run audit:phase1:route && npm run audit:phase1:api && npm run audit:phase1:runtime && npm run audit:phase1:signoff",
    "audit:mission-critical:x3": "sh -c 'for i in 1 2 3; do echo \"[mission-critical] run $i/3\"; npm run audit:mission-critical || exit 1; done'",
    "test:tourney-retirement:postgres17": "node scripts/test-tourney-retirement-postgres.mjs",
    "test:tourney-retirement:phases": "node --test tests/tourney-retirement-phases.test.mjs",
    "test:referral-orphan-prerequisites:postgres17": "node scripts/test-referral-orphan-prerequisites-postgres.mjs",
    "test:tooling:safety": "node scripts/test-tooling-sweep.mjs",
    "test:tooling:dependencies": "node scripts/test-tooling-sweep-dependencies.mjs",
    "audit:lighthouse": "lhci autorun --collect.url=http://${ROO_TEST_HOST:-127.0.0.1}:3001/ --collect.url=http://${ROO_TEST_HOST:-127.0.0.1}:3001/reviews --collect.url=http://${ROO_TEST_HOST:-127.0.0.1}:3001/tools",
    "audit:lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.json --collect.url=http://${ROO_TEST_HOST:-127.0.0.1}:3001/",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.55.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.18",
    "tus-js-client": "^4.3.1"
